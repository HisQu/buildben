"""Validate the SDK's exact native release assets and SHA256SUMS."""

from __future__ import annotations

import hashlib
import re
from collections.abc import Mapping, Sequence
from pathlib import Path

CHECKSUMS_NAME = "SHA256SUMS"
NATIVE_SETUPS = (
    "{app_id}-setup-linux-x86_64",
    "{app_id}-setup-windows-x86_64.exe",
)


def asset_basename(value: str, label: str = "Release asset") -> str:
    """Reject unsafe filenames before staging or downloading an asset."""
    if (
        not value
        or value in {".", ".."}
        or Path(value).name != value
        or any(character in value for character in "/\\\r\n\x00:")
    ):
        raise ValueError(f"{label} must be a safe basename.")
    return value


def native_asset_names(app_id: str) -> tuple[str, ...]:
    """Return the only supported native release filenames."""
    asset_basename(app_id, "Application identity")
    return tuple(
        sorted(
            (
                CHECKSUMS_NAME,
                *(name.format(app_id=app_id) for name in NATIVE_SETUPS),
            )
        )
    )


def expected_asset_names(
    names: Sequence[str],
    *,
    app_id: str,
    payload_format: str | None = None,
) -> tuple[str, ...]:
    """Require exactly the final native release set."""
    del payload_format
    for name in names:
        asset_basename(name)
    expected = native_asset_names(app_id)
    if len(names) != len(set(names)) or set(names) != set(expected):
        raise ValueError(
            "Release contains missing, duplicate or unexpected native assets."
        )
    return expected


def checksum_bytes(payload: Mapping[str, bytes], *, app_id: str) -> bytes:
    """Encode SHA256SUMS for exactly the two final setup executables."""
    expected_asset_names((*payload, CHECKSUMS_NAME), app_id=app_id)
    return "".join(
        f"{hashlib.sha256(content).hexdigest()}  {name}\n"
        for name, content in sorted(payload.items())
    ).encode("ascii")


def validate_checksums(
    payload: Mapping[str, bytes], *, app_id: str
) -> tuple[str, ...]:
    """Validate exact checksum inventory and executable bytes without writes."""
    names = expected_asset_names(tuple(payload), app_id=app_id)
    try:
        lines = payload[CHECKSUMS_NAME].decode("ascii").splitlines()
    except UnicodeError as error:
        raise ValueError(
            "SHA256SUMS must contain ASCII checksum lines."
        ) from error
    seen: set[str] = set()
    for line in lines:
        match = re.fullmatch(r"([0-9a-f]{64})  ([^\r\n]+)", line)
        if match is None:
            raise ValueError("Malformed SHA256SUMS line.")
        digest, name = match.groups()
        asset_basename(name)
        if name in seen or name == CHECKSUMS_NAME or name not in payload:
            raise ValueError(
                "SHA256SUMS contains duplicate or unexpected assets."
            )
        seen.add(name)
        if hashlib.sha256(payload[name]).hexdigest() != digest:
            raise ValueError(f"Release asset SHA-256 does not match: {name}.")
    if seen != set(names) - {CHECKSUMS_NAME}:
        raise ValueError("SHA256SUMS omits final setup assets.")
    return names


def validate_directory(
    directory: Path, *, app_id: str, exact: bool = False
) -> tuple[str, ...]:
    """Read the exact native release assets from their output directory."""
    names = native_asset_names(app_id)
    if directory.is_symlink() or not directory.is_dir():
        raise ValueError("Native output directory is missing or linked.")
    if exact and {path.name for path in directory.iterdir()} != set(names):
        raise ValueError(
            "Staging directory contains missing or unexpected release files."
        )
    payload = {}
    for name in names:
        path = directory / name
        if path.is_symlink() or not path.is_file():
            raise ValueError(f"Release asset is not a regular file: {name}.")
        payload[name] = path.read_bytes()
    return validate_checksums(payload, app_id=app_id)
