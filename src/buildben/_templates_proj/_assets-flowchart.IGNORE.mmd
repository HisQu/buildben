---
config:
  title: "{my_project} flowchart"
  theme: base
  themeVariables:
    fontSize: 20px
    primaryTextColor: "#000000"
    primaryColor: "#cccccc77"
    primaryBorderColor: "#666666"
    lineColor: "#00A2FF"
    secondaryColor: "#00A2FF19"
    tertiaryTextColor: "#000000"
    tertiaryColor: "#44444419"
    tertiaryBorderColor: "#00000000"
---

%% Node borders show ownership. Group fills show boundaries.
%% Set link and class styles after declaring the links and nodes.

flowchart TB

    subgraph Dependencies[Dependencies]
        auth["Authentication library"]
        client["Service client"]
    end

    subgraph {MyProject}System["{my_project} system"]
        subgraph RuntimeServices[Runtime services]
            direction LR
            api["Application API"]
            worker["Background worker"]
            scheduler["Scheduler"]
        end

        subgraph DataStores[Data stores]
            records[("Records")]
            cache[("Cache")]
        end

        subgraph SharedStorage[Shared storage]
            files[("Files")]
        end

        subgraph Operations[Operations tools]
            monitor["Monitor"]
            admin["Admin tool"]
        end
    end

    subgraph ExternalServices[External services]
        identity["Identity provider"]
        partner["Partner API"]
    end

    request["Request"]
    response(["Response"])
    archive[("Backup archive")]

    request --> api
    auth -. validates .-> api
    api --> worker
    worker -.-> scheduler
    api <--> records
    worker --> cache
    worker -. writes .-> files
    scheduler -. archives .-> archive
    api -. identity .-> identity
    client -. calls .-> api
    api <-- response --> partner
    monitor -. inspects .-> worker
    admin -. manages .-> DataStores
    api --> response

    %% Links
    %% Indexes follow the links above, starting at zero.
    linkStyle default stroke-width:2px
    linkStyle 1,3,6,7,9 stroke-dasharray:4,3
    linkStyle 4 stroke:#00A2FF,stroke-width:3px

    %% Node styles
    %% Set node and link widths in styles at the end of the diagram.
    classDef service fill:#cccccc77,stroke:#666666,stroke-width:2px
    classDef dependency fill:#00A2FF19,stroke:#00A2FF,stroke-width:2px
    classDef infrastructure fill:#44444419,stroke:#666666,stroke-width:2px
    classDef output fill:#32bc0019,stroke:#32bc00ff,stroke-width:2px
    class api,worker,scheduler,request service
    class auth,client,identity,partner dependency
    class records,cache,files,archive,monitor,admin infrastructure
    class response output

    %% Group styles
    %% Subgraphs stay borderless unless their boundary carries meaning.
    classDef subgraph_default fill:#00000000,stroke:#666666,stroke-width:1px
    classDef subgraph_project fill:#00A2FF19,stroke:#00000000,stroke-width:0px
    class Dependencies,ExternalServices subgraph_default
    class {MyProject}System,RuntimeServices,DataStores,SharedStorage,Operations subgraph_project
