"""Install a verified application wheel from a published GitHub release."""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import shutil
import subprocess
import tempfile
import urllib.error
import urllib.request
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Protocol

VERSION_RE = re.compile(r"(?:0|[1-9]\d*)\.(?:0|[1-9]\d*)\.(?:0|[1-9]\d*)")
TARGETS = {
    "windows-x86_64": "zip",
    "linux-x86_64": "tar.gz",
    "macos-arm64": "tar.gz",
}
PAYLOAD_FILES = (
    "release-manifest.json",
    "runtime-requirements.txt",
    "runtime-constraints.txt",
)


def _normalize(name: str) -> str:
    return re.sub(r"[-_.]+", "-", name).lower()


def _basename(value: Any) -> str:
    if (
        not isinstance(value, str)
        or not re.fullmatch(r"[A-Za-z0-9_.-]+", value)
        or value in {".", ".."}
    ):
        raise ValueError(f"Unsafe manifest filename: {value!r}")
    return value


def archive_members(
    target: str, *, internal_windows: bool = False
) -> list[str]:
    """Return canonical manifest and launcher paths for one platform."""
    files = [*PAYLOAD_FILES, "install_release.py"]
    if target == "windows-x86_64":
        prefix = "windows-internal/" if internal_windows else ""
        files += [
            prefix + "install-windows.ps1",
            prefix + "prepare-powershell-windows.cmd",
        ]
        files += (
            ["launch-windows.cmd", prefix + "launch-windows.ps1"]
            if internal_windows
            else ["install-windows.cmd"]
        )
    else:
        files += ["install-linux-macos.sh"]
        if internal_windows:
            files += ["launch-linux-macos.sh"]
        if target == "macos-arm64":
            files += ["install-macos.command"]
    return sorted(files)


def validate_manifest(
    manifest: Any, repository: str, commit: str
) -> dict[str, Any]:
    """Validate the fixed schema, safe names, archive contents, and source pin."""
    keys = {
        "schema_version",
        "project",
        "version",
        "tag",
        "repository",
        "commit_sha",
        "python_requires",
        "application_wheel",
        "source_archive",
        "runtime_lock",
        "runtime_constraints",
        "platforms",
        "archive_members",
    }
    if (
        not isinstance(manifest, dict)
        or set(manifest) != keys
        or type(manifest.get("schema_version")) is not int
        or manifest["schema_version"] != 1
    ):
        raise ValueError("Unsupported or malformed release manifest")
    if (
        not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repository)
        or not re.fullmatch(r"[0-9a-f]{40}", commit)
        or manifest.get("repository") != repository
        or manifest.get("commit_sha") != commit
    ):
        raise ValueError(
            "Release manifest source identity does not match the requested source"
        )
    project, version = manifest.get("project"), manifest.get("version")
    if (
        not isinstance(project, str)
        or not re.fullmatch(r"[A-Za-z0-9_.-]+", project)
        or not isinstance(version, str)
        or not VERSION_RE.fullmatch(version)
        or manifest.get("tag") != f"v{version}"
    ):
        raise ValueError(
            "Malformed or inconsistent release project/tag/version"
        )
    if (
        not isinstance(manifest.get("python_requires"), str)
        or not manifest["python_requires"].strip()
    ):
        raise ValueError("Release manifest Python requirement is missing")
    for field in (
        "application_wheel",
        "source_archive",
        "runtime_lock",
        "runtime_constraints",
    ):
        entry = manifest[field]
        if (
            not isinstance(entry, dict)
            or set(entry) != {"filename", "sha256"}
            or not isinstance(entry.get("sha256"), str)
            or not re.fullmatch(r"[0-9a-f]{64}", entry["sha256"])
        ):
            raise ValueError(f"Malformed {field} manifest entry")
        _basename(entry["filename"])
    wheel = manifest["application_wheel"]["filename"]
    parts = wheel.removesuffix(".whl").split("-")
    if (
        not wheel.endswith(".whl")
        or len(parts) not in (5, 6)
        or _normalize(parts[0]) != _normalize(project)
        or parts[1] != version
    ):
        raise ValueError("Application wheel does not match project/version")
    sdist = manifest["source_archive"]["filename"]
    if not sdist.endswith(f"-{version}.tar.gz") or _normalize(
        sdist[: -len(f"-{version}.tar.gz")]
    ) != _normalize(project):
        raise ValueError("Source archive does not match project/version")
    if (
        manifest["runtime_lock"]["filename"] != PAYLOAD_FILES[1]
        or manifest["runtime_constraints"]["filename"] != PAYLOAD_FILES[2]
    ):
        raise ValueError("Release manifest runtime filenames are inconsistent")
    platforms, members = manifest["platforms"], manifest["archive_members"]
    if (
        not isinstance(platforms, dict)
        or set(platforms) != set(TARGETS)
        or not isinstance(members, dict)
        or set(members) != set(TARGETS)
    ):
        raise ValueError("Release manifest has an invalid platform/member set")
    internal = (
        isinstance(members.get("windows-x86_64"), list)
        and "windows-internal/install-windows.ps1" in members["windows-x86_64"]
    )
    for target, suffix in TARGETS.items():
        _basename(platforms[target])
        if platforms[
            target
        ] != f"{project}-{version}-{target}.{suffix}" or members[
            target
        ] != archive_members(target, internal_windows=internal):
            raise ValueError(
                f"Unsafe or inconsistent archive contract for {target}"
            )
    return manifest


@dataclass(frozen=True, slots=True)
class ReleaseSelection:
    """Immutable release identity resolved once for an install."""

    repository: str
    tag: str
    commit_sha: str
    release_id: int
    draft: bool
    prerelease: bool


class ReleaseSource(Protocol):
    """Transport boundary for the release resolver and named asset downloads."""

    def resolve(self, version: str | None) -> ReleaseSelection: ...
    def download_asset(
        self, selection: ReleaseSelection, filename: str, destination: Path
    ) -> None: ...


class GitHubReleaseSource:
    """Resolve public GitHub releases anonymously or use authenticated gh."""

    def __init__(self, repository: str):
        if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repository):
            raise ValueError("Repository must be OWNER/REPO")
        self.repository = repository
        self._assets: dict[int, list[dict[str, Any]]] = {}

    def _request(self, endpoint: str, *, binary: bool = False) -> bytes:
        accept = (
            "application/octet-stream"
            if binary
            else "application/vnd.github+json"
        )
        if shutil.which("gh"):
            try:
                return subprocess.run(
                    ["gh", "api", endpoint, "-H", f"Accept: {accept}"],
                    check=True,
                    capture_output=True,
                ).stdout
            except subprocess.CalledProcessError as error:
                raise RuntimeError(
                    "GitHub request failed; check gh authentication and repository access"
                ) from error
        request = urllib.request.Request(
            f"https://api.github.com/{endpoint}",
            headers={"Accept": accept, "User-Agent": "release-installer"},
        )
        try:
            with urllib.request.urlopen(request, timeout=60) as response:
                return response.read()
        except urllib.error.URLError as error:
            raise RuntimeError(
                "GitHub request failed; authenticate with gh for private repositories or check release availability"
            ) from error

    def resolve(self, version: str | None) -> ReleaseSelection:
        requested = _version_tag(version) if version else None
        endpoint = f"repos/{self.repository}/releases/" + (
            f"tags/{requested}" if requested else "latest"
        )
        data = json.loads(self._request(endpoint))
        tag = data.get("tag_name")
        if (
            not isinstance(tag, str)
            or _version_tag(tag) != tag
            or (requested and requested != tag)
            or data.get("draft") is not False
            or data.get("prerelease") is not False
        ):
            raise ValueError(
                "GitHub did not return the requested published non-prerelease release"
            )
        ref = json.loads(
            self._request(f"repos/{self.repository}/git/ref/tags/{tag}")
        )["object"]
        visited: set[str] = set()
        while ref["type"] == "tag":
            sha = ref["sha"]
            if not re.fullmatch(r"[0-9a-f]{40}", sha) or sha in visited:
                raise ValueError("Invalid or cyclic annotated release tag")
            visited.add(sha)
            ref = json.loads(
                self._request(f"repos/{self.repository}/git/tags/{sha}")
            )["object"]
        if ref["type"] != "commit" or not re.fullmatch(
            r"[0-9a-f]{40}", ref["sha"]
        ):
            raise ValueError("Release tag does not resolve to a full commit")
        return ReleaseSelection(
            self.repository, tag, ref["sha"], int(data["id"]), False, False
        )

    def download_asset(
        self, selection: ReleaseSelection, filename: str, destination: Path
    ) -> None:
        _basename(filename)
        if selection.repository != self.repository:
            raise ValueError("Release belongs to another repository")
        if selection.release_id not in self._assets:
            assets: list[dict[str, Any]] = []
            page = 1
            while True:
                batch = json.loads(
                    self._request(
                        f"repos/{self.repository}/releases/{selection.release_id}/assets?per_page=100&page={page}"
                    )
                )
                assets.extend(batch)
                if len(batch) < 100:
                    break
                page += 1
            self._assets[selection.release_id] = assets
        matches = [
            asset
            for asset in self._assets[selection.release_id]
            if asset.get("name") == filename
        ]
        if len(matches) != 1:
            raise RuntimeError(
                f"Release {selection.tag} has no unique thin installer payload asset {filename!r}; legacy releases require an explicit developer installation"
            )
        destination.write_bytes(
            self._request(
                f"repos/{self.repository}/releases/assets/{int(matches[0]['id'])}",
                binary=True,
            )
        )


def _version_tag(version: str) -> str:
    clean = version.removeprefix("v")
    if not VERSION_RE.fullmatch(clean):
        raise ValueError(f"Invalid version: {version!r}")
    return f"v{clean}"


def _verified(path: Path, digest: str, label: str) -> bytes:
    if path.is_symlink() or not path.is_file():
        raise ValueError(f"Missing or unsafe {label} asset")
    data = path.read_bytes()
    if hashlib.sha256(data).hexdigest() != digest:
        raise ValueError(f"Missing or corrupt {label} asset")
    return data


def install_release(
    *,
    repository: str,
    distribution: str,
    uv: Path,
    python: Path,
    version: str | None = None,
    asset_dir: Path | None = None,
    source: ReleaseSource | None = None,
) -> None:
    """Verify all release files in private storage before installing one wheel.

    :param repository: GitHub repository in OWNER/REPO form.
    :param distribution: Project distribution name expected in the manifest.
    :param uv: Absolute path to the uv executable.
    :param python: Absolute compatible Python interpreter path.
    :param version: Optional exact semantic release version.
    :param asset_dir: Optional complete local prepared payload directory.
    :param source: Optional injectable release source used by tests.
    :return: None.
    """
    if not uv.is_absolute() or not python.is_absolute():
        raise ValueError("--uv and --python must be absolute executable paths")
    requested = _version_tag(version) if version else None
    release_source = source or GitHubReleaseSource(repository)
    adjacent = Path(__file__).resolve().parent
    local = (
        asset_dir
        if asset_dir is not None
        else (
            adjacent
            if any((adjacent / name).exists() for name in PAYLOAD_FILES)
            else None
        )
    )
    with tempfile.TemporaryDirectory(prefix="release-install-") as temporary:
        directory = Path(temporary)
        selection: ReleaseSelection | None = None
        if local is not None:
            for filename in PAYLOAD_FILES:
                if (local / filename).is_symlink() or not (
                    local / filename
                ).is_file():
                    raise ValueError(
                        f"Incomplete installer asset directory: missing or unsafe {filename}"
                    )
            manifest_data = (local / PAYLOAD_FILES[0]).read_bytes()
        else:
            selection = release_source.resolve(version)
            if requested and selection.tag != requested:
                raise ValueError(
                    "Requested version disagrees with the resolved release"
                )
            if (
                selection.repository != repository
                or selection.draft
                or selection.prerelease
                or selection.release_id <= 0
            ):
                raise ValueError(
                    "Release source returned an ineligible release"
                )
            release_source.download_asset(
                selection, PAYLOAD_FILES[0], directory / PAYLOAD_FILES[0]
            )
            manifest_data = (directory / PAYLOAD_FILES[0]).read_bytes()
        manifest = json.loads(manifest_data)
        commit = (
            selection.commit_sha
            if selection
            else manifest.get("commit_sha", "")
        )
        validate_manifest(manifest, repository, commit)
        if _normalize(manifest["project"]) != _normalize(distribution):
            raise ValueError(
                "Release manifest does not match the requested application"
            )
        if requested and manifest["tag"] != requested:
            raise ValueError(
                "Requested version disagrees with the payload manifest"
            )
        if selection and manifest["tag"] != selection.tag:
            raise ValueError(
                "Release manifest does not match the resolved GitHub release"
            )
        for field in ("runtime_lock", "runtime_constraints"):
            entry = manifest[field]
            path = directory / entry["filename"]
            if local is not None:
                path.write_bytes(
                    _verified(local / entry["filename"], entry["sha256"], field)
                )
            else:
                assert selection is not None
                release_source.download_asset(
                    selection, entry["filename"], path
                )
                _verified(path, entry["sha256"], field)
        entry = manifest["application_wheel"]
        wheel = directory / entry["filename"]
        if local is not None and (local / entry["filename"]).exists():
            wheel.write_bytes(
                _verified(
                    local / entry["filename"],
                    entry["sha256"],
                    "application wheel",
                )
            )
        else:
            if selection is None:
                selection = release_source.resolve(manifest["version"])
                if (
                    selection.repository != repository
                    or selection.tag != manifest["tag"]
                    or selection.commit_sha != manifest["commit_sha"]
                    or selection.draft
                    or selection.prerelease
                ):
                    raise ValueError(
                        "Local payload does not match the published release identity"
                    )
            release_source.download_asset(selection, entry["filename"], wheel)
            _verified(wheel, entry["sha256"], "application wheel")
        subprocess.run(
            [
                str(uv),
                "tool",
                "install",
                "--force",
                "--refresh",
                "--python",
                str(python),
                "--with-requirements",
                str(directory / manifest["runtime_lock"]["filename"]),
                "--constraints",
                str(directory / manifest["runtime_constraints"]["filename"]),
                str(wheel),
            ],
            check=True,
        )


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    """Parse the standalone installer CLI."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repository", required=True)
    parser.add_argument("--distribution", required=True)
    parser.add_argument("--uv", type=Path, required=True)
    parser.add_argument("--python", type=Path, required=True)
    parser.add_argument("--version")
    parser.add_argument("--asset-dir", type=Path)
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    """Validate arguments, install the release, and report actionable errors."""
    args = parse_args(argv)
    try:
        install_release(
            repository=args.repository,
            distribution=args.distribution,
            uv=args.uv,
            python=args.python,
            version=args.version,
            asset_dir=args.asset_dir,
        )
    except (
        OSError,
        ValueError,
        RuntimeError,
        KeyError,
        TypeError,
        subprocess.CalledProcessError,
    ) as error:
        raise SystemExit(f"release installation error: {error}") from error
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
