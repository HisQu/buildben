"""Application settings registered with AppRC for <my_project>."""

from __future__ import annotations

# == Standard Library ========================
from pathlib import Path

# == 3rd Party ===============================
import apprc as rc

# == Internal ================================
from <my_project>.config.app import APP_RC


@APP_RC.config(
    "app",
    prefix="<MY_PROJECT>_",
    title="App",
    rc_path=("app",),
)
class AppSettings(rc.Config):
    """Typed application settings loaded from AppRC-managed env layers."""

    storage_root: Path = rc.field(
        "<MY_PROJECT>_STORAGE",
        title="Storage root",
        explanation_short="Directory where the application stores its persistent data.",
        explanation_long=(
            "Choose the storage root through the command-line option, environment "
            "variable, or saved storage registry selection."
        ),
        editable=False,
        required=True,
    )
    message: str = rc.field(
        "<MY_PROJECT>_MESSAGE",
        default="Hello from <my_project>",
        title="Example message",
        explanation_short="Small editable example setting.",
        explanation_long=(
            "This field exists so a new scaffold immediately demonstrates "
            "`<my_project> config set app.message VALUE` and the Textual "
            "config editor. Replace it with real application settings."
        ),
    )
