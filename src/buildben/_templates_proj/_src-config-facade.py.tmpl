"""Lazy public exports for <my_project>'s AppRC config package."""

from importlib import import_module


_ALL_EXPORTS = (
    "APP_RC",
    "CONFIG_SECTIONS",
    "CONFIG_SPEC",
    "<MyProject>Config",
    "SECTION_BY_KEY",
)

_EXPORT_MODULES = {
    "APP_RC": ".app",
    "CONFIG_SECTIONS": ".catalog",
    "CONFIG_SPEC": ".catalog",
    "<MyProject>Config": ".bundle",
    "SECTION_BY_KEY": ".catalog",
}

__all__ = list(_ALL_EXPORTS)


def __getattr__(name: str) -> object:
    """Load a public config name when a caller first requests it.

    :param name: Export requested through attribute access or import machinery.
    :return: Object from the module that defines the requested export.
    """
    try:
        module_name = _EXPORT_MODULES[name]
    except KeyError as exc:
        raise AttributeError(
            f"module {__name__!r} has no attribute {name!r}"
        ) from exc
    module = import_module(module_name, __package__)
    value = getattr(module, name)
    globals()[name] = value
    return value


def __dir__() -> list[str]:
    """List regular module attributes together with lazy public names.

    :return: Sorted names available from this facade.
    """
    return sorted({*globals(), *__all__})
