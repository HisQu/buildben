"""Stage and publish validated Buildben release assets through GitHub."""
# > Run this CLI from the checked project root so prepare reads its pyproject.toml.

from __future__ import annotations

import argparse
import hashlib
import io
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import tomllib
import zipfile
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path, PurePosixPath
from typing import Protocol

from .release_manifest import (
    CHECKSUMS_NAME,
    asset_basename,
    checksum_bytes,
    expected_asset_names,
    validate_checksums,
    validate_directory,
)

from .release_notes import VERSION_RE, release_channel, validate_tag_version

SHA_RE = re.compile(r"^[0-9a-f]{40,64}$")
RELEASES_PER_PAGE = 100


class ReleaseError(RuntimeError):
    """Raised when release identity, payload, or remote state is invalid."""


class _ReleaseNotFound(ReleaseError):
    """Raised when a successful release listing contains no matching tag."""


class Api(Protocol):
    """Minimal GitHub API boundary used by the publisher and stateful tests."""

    def request(
        self,
        method: str,
        endpoint: str,
        *,
        data: bytes | None = None,
        headers: tuple[str, ...] = (),
    ) -> bytes: ...
    def watch_ci(self, repository: str, run_id: int) -> int: ...


@dataclass(frozen=True, slots=True)
class Identity:
    """Immutable tag identity required by every mutating operation."""

    repository: str
    tag: str
    commit: str


class GitHubApi:
    """Run authenticated GitHub requests through the user's ``gh`` client."""

    def request(
        self,
        method: str,
        endpoint: str,
        *,
        data: bytes | None = None,
        headers: tuple[str, ...] = (),
    ) -> bytes:
        command = ["gh", "api", "--method", method.upper()]
        for header in headers:
            command.extend(("--header", header))
        if data is not None:
            command.extend(("--input", "-"))
        command.append(endpoint)
        result = subprocess.run(
            command,
            input=data,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        if result.returncode:
            detail = result.stderr.decode("utf-8", errors="replace").strip()
            raise ReleaseError(f"GitHub API request failed: {detail}")
        return result.stdout

    def watch_ci(self, repository: str, run_id: int) -> int:
        result = subprocess.run(
            [
                "gh",
                "run",
                "watch",
                str(run_id),
                "--exit-status",
                "--repo",
                repository,
            ],
            check=False,
        )
        return result.returncode


def _json(
    api: Api, method: str, endpoint: str, payload: object | None = None
) -> object:
    body = (
        None
        if payload is None
        else json.dumps(payload, separators=(",", ":")).encode()
    )
    raw = api.request(method, endpoint, data=body)
    try:
        return json.loads(raw) if raw else {}
    except json.JSONDecodeError as exc:
        raise ReleaseError(
            f"GitHub returned invalid JSON for {endpoint}"
        ) from exc


def _repository(value: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", value):
        raise ReleaseError("Repository must be OWNER/REPO.")
    return value


def _tag(value: str) -> str:
    if not value.startswith("v") or not VERSION_RE.fullmatch(value[1:]):
        raise ReleaseError(
            "Tag must be vMAJOR.MINOR.PATCH with optional bN or rcN."
        )
    return value


def _sha(value: str) -> str:
    if not SHA_RE.fullmatch(value):
        raise ReleaseError("Commit must be a full immutable Git commit SHA.")
    return value


def _endpoint(repository: str, suffix: str) -> str:
    return f"/repos/{_repository(repository)}/{suffix.lstrip('/')}"


def _tag_commit(api: Api, identity: Identity) -> str:
    """Resolve the exact remote tag ref and peel annotated tags to a commit."""
    ref = _json(
        api,
        "GET",
        _endpoint(identity.repository, f"git/ref/tags/{identity.tag}"),
    )
    if not isinstance(ref, dict) or not isinstance(ref.get("object"), dict):
        raise ReleaseError(f"Remote tag {identity.tag} has no Git object.")
    obj = ref["object"]
    object_type, object_sha = obj.get("type"), obj.get("sha")
    if not isinstance(object_sha, str) or not SHA_RE.fullmatch(object_sha):
        raise ReleaseError(
            f"Remote tag {identity.tag} has an invalid object SHA."
        )
    if object_type == "tag":
        annotated = _json(
            api, "GET", _endpoint(identity.repository, f"git/tags/{object_sha}")
        )
        if not isinstance(annotated, dict) or not isinstance(
            annotated.get("object"), dict
        ):
            raise ReleaseError(
                f"Annotated tag {identity.tag} cannot be peeled."
            )
        peeled = annotated["object"]
        if peeled.get("type") != "commit":
            raise ReleaseError(
                f"Remote tag {identity.tag} does not peel directly to a commit."
            )
        commit = peeled.get("sha")
    elif object_type == "commit":
        commit = object_sha
    else:
        raise ReleaseError(
            f"Remote tag {identity.tag} does not identify a commit."
        )
    if not isinstance(commit, str) or not SHA_RE.fullmatch(commit):
        raise ReleaseError(
            f"Remote tag {identity.tag} has an invalid peeled commit SHA."
        )
    if commit != identity.commit:
        raise ReleaseError(
            f"Remote tag {identity.tag} points to {commit}, not {identity.commit}."
        )
    return commit


def _list_releases(api: Api, repository: str) -> list[dict[str, object]]:
    releases: list[dict[str, object]] = []
    seen_ids: set[int] = set()
    page = 1
    while True:
        endpoint = _endpoint(
            repository, f"releases?per_page={RELEASES_PER_PAGE}&page={page}"
        )
        result = _json(api, "GET", endpoint)
        if not isinstance(result, list) or len(result) > RELEASES_PER_PAGE:
            raise ReleaseError("GitHub release listing page is malformed.")
        for item in result:
            if not isinstance(item, dict) or not isinstance(
                item.get("tag_name"), str
            ):
                raise ReleaseError(
                    "GitHub release listing contains a malformed release."
                )
            release_id = _release_id(item)
            if release_id in seen_ids:
                raise ReleaseError(
                    "GitHub release listing repeats an identifier."
                )
            seen_ids.add(release_id)
            releases.append(item)
        if len(result) < RELEASES_PER_PAGE:
            return releases
        page += 1


def _release(
    api: Api, identity: Identity, *, allow_published: bool = False
) -> dict[str, object]:
    matches = [
        item
        for item in _list_releases(api, identity.repository)
        if item["tag_name"] == identity.tag
    ]
    if len(matches) > 1:
        raise ReleaseError(
            f"GitHub release listing ambiguously identifies tag {identity.tag}."
        )
    match = matches[0] if matches else None
    if match is None:
        raise _ReleaseNotFound(
            f"No GitHub release exists for tag {identity.tag}."
        )
    if match.get("tag_name") != identity.tag:
        raise ReleaseError(
            f"GitHub release does not identify exact tag {identity.tag}."
        )
    if match.get("draft") is not True and not (
        allow_published and match.get("draft") is False
    ):
        raise ReleaseError(
            f"Release {identity.tag} is published; refusing to mutate it."
        )
    if match.get("target_commitish") != identity.commit:
        raise ReleaseError(
            f"Draft {identity.tag} has an inconsistent target commit."
        )
    if match.get("prerelease") is not (
        release_channel(identity.tag[1:]) != "stable"
    ):
        raise ReleaseError(
            f"Draft {identity.tag} does not match its release channel."
        )
    return match


def _release_id(release: dict[str, object]) -> int:
    value = release.get("id")
    if not isinstance(value, int) or isinstance(value, bool) or value <= 0:
        raise ReleaseError("Draft release has an invalid identifier.")
    return value


def _assets(release: dict[str, object]) -> dict[str, dict[str, object]]:
    value = release.get("assets")
    if not isinstance(value, list):
        raise ReleaseError("Draft release has a malformed asset list.")
    result: dict[str, dict[str, object]] = {}
    for item in value:
        if not isinstance(item, dict) or not isinstance(item.get("name"), str):
            raise ReleaseError("Draft release contains a malformed asset.")
        name = item["name"]
        if name in result:
            raise ReleaseError(f"Draft contains duplicate asset {name}.")
        result[name] = item
    return result


def _normalize(value: str) -> str:
    return re.sub(r"[-_.]+", "_", value).lower()


def _project() -> tuple[str, str]:
    try:
        with Path("pyproject.toml").open("rb") as stream:
            project = tomllib.load(stream)["project"]
        name, version = project["name"], project["version"]
    except (OSError, KeyError, TypeError, tomllib.TOMLDecodeError) as exc:
        raise ReleaseError(
            "Cannot read project name and version from pyproject.toml."
        ) from exc
    if not isinstance(name, str) or not isinstance(version, str):
        raise ReleaseError("Project name and version must be strings.")
    return name, version


def _safe_member(value: str) -> PurePosixPath:
    path = PurePosixPath(value)
    if (
        not value
        or path.is_absolute()
        or "\\" in value
        or ".." in path.parts
        or re.match(r"^[A-Za-z]:", value)
    ):
        raise ReleaseError(f"Unsafe archive member: {value!r}.")
    return path


def _sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _metadata_matches(
    data: bytes, name: str, version: str, filename: str
) -> None:
    from email.parser import BytesParser

    metadata = BytesParser().parsebytes(data)
    if (
        _normalize(metadata.get("Name", "")) != _normalize(name)
        or metadata.get("Version") != version
    ):
        raise ReleaseError(
            f"Package metadata in {filename} does not match {name} {version}."
        )


def _validate_package(
    path: Path, name: str, version: str, data: bytes | None = None
) -> bytes:
    if not path.is_file() or path.is_symlink():
        raise ReleaseError(
            f"Release asset {path.name} is missing or not a regular file."
        )
    data = path.read_bytes() if data is None else data
    if path.name.endswith(".whl"):
        try:
            with zipfile.ZipFile(io.BytesIO(data)) as archive:
                names = set()
                for item in archive.infolist():
                    _safe_member(item.filename.rstrip("/"))
                    mode = item.external_attr >> 16
                    if mode & 0o170000 == 0o120000:
                        raise ReleaseError(
                            f"Wheel {path.name} contains a symbolic link."
                        )
                    if item.filename in names:
                        raise ReleaseError(
                            f"Wheel {path.name} has duplicate members."
                        )
                    names.add(item.filename)
                metadata_names = [
                    item
                    for item in names
                    if item.endswith(".dist-info/METADATA")
                ]
                if len(metadata_names) != 1:
                    raise ReleaseError(
                        f"Wheel {path.name} must contain one METADATA file."
                    )
                _metadata_matches(
                    archive.read(metadata_names[0]), name, version, path.name
                )
        except (OSError, zipfile.BadZipFile) as exc:
            raise ReleaseError(f"Invalid wheel {path.name}.") from exc
        normalized = _normalize(path.name[:-4])
        if not normalized.startswith(
            f"{_normalize(name)}_{_normalize(version)}_"
        ):
            raise ReleaseError(
                f"Wheel filename {path.name} does not match project/version."
            )
    else:
        import tarfile

        stem = path.name.removesuffix(".tar.gz")
        if not stem.endswith("-" + version) or _normalize(
            stem[: -(len(version) + 1)]
        ) != _normalize(name):
            raise ReleaseError(
                f"Source archive filename {path.name} does not match project/version."
            )
        try:
            with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as archive:
                roots: set[str] = set()
                metadata = []
                for member in archive.getmembers():
                    safe = _safe_member(member.name)
                    roots.add(safe.parts[0])
                    if (
                        member.issym()
                        or member.islnk()
                        or not (member.isfile() or member.isdir())
                    ):
                        raise ReleaseError(
                            f"Source archive {path.name} contains a link "
                            "or special file."
                        )
                    if len(safe.parts) == 2 and safe.parts[1] == "PKG-INFO":
                        stream = archive.extractfile(member)
                        if stream is None:
                            raise ReleaseError(
                                f"Cannot read PKG-INFO from {path.name}."
                            )
                        metadata.append(stream.read())
                if len(roots) != 1 or len(metadata) != 1:
                    raise ReleaseError(
                        f"Source archive {path.name} must have one root "
                        "and one PKG-INFO."
                    )
                _metadata_matches(metadata[0], name, version, path.name)
        except (OSError, tarfile.TarError) as exc:
            raise ReleaseError(f"Invalid source archive {path.name}.") from exc
    return data


def _project_app_id(distribution: str) -> str:
    """Read only portable author identity, never application configuration."""
    with Path("pyproject.toml").open("rb") as stream:
        metadata = tomllib.load(stream)
    value = (
        metadata.get("tool", {})
        .get("apprc", {})
        .get("distribution", {})
        .get("app-id", re.sub(r"[-_.]+", "-", distribution).lower())
    )
    if not isinstance(value, str):
        raise ReleaseError("Release app-id must be a string.")
    return value


def _package_names(names: list[str]) -> tuple[str, ...]:
    return tuple(name for name in names if name.endswith((".whl", ".tar.gz")))


def _check_asset_names(names: list[str]) -> tuple[str, ...]:
    try:
        for name in names:
            asset_basename(name)
        packages = _package_names(names)
        if packages and (
            len(packages) != 2
            or sum(name.endswith(".whl") for name in packages) != 1
        ):
            raise ValueError(
                "Release must contain one wheel and one source archive."
            )
        native = [name for name in names if name not in packages]
        if native or not packages:
            expected_asset_names(native, app_id=_project_app_id(_project()[0]))
        return tuple(sorted(names))
    except ValueError as error:
        raise ReleaseError(str(error)) from error


def _validate_local_files(
    directory: Path,
    names: list[str],
    identity: Identity,
    *,
    expected_version: str | None = None,
) -> dict[str, bytes]:
    _check_asset_names(names)
    if directory.is_symlink() or not directory.is_dir():
        raise ReleaseError("Staging directory is missing or linked.")
    project_name, current_version = _project()
    version = current_version if expected_version is None else expected_version
    if identity.tag != f"v{version}":
        raise ReleaseError("Project version does not match the release tag.")
    if directory.is_symlink() or {
        entry.name for entry in directory.iterdir()
    } != set(names):
        raise ReleaseError(
            "Staging directory contains missing or unexpected release files."
        )
    payload: dict[str, bytes] = {}
    for filename in names:
        path = directory / filename
        if not path.is_file() or path.is_symlink():
            raise ReleaseError(
                f"Release asset is not a regular file: {filename}."
            )
        data = path.read_bytes()
        if filename in _package_names(names):
            _validate_package(path, project_name, version, data)
        payload[filename] = data
    try:
        native = {
            key: value
            for key, value in payload.items()
            if key not in _package_names(names)
        }
        if native:
            validate_checksums(native, app_id=_project_app_id(project_name))
    except ValueError as error:
        raise ReleaseError(str(error)) from error
    return payload


def stage(
    directory: Path,
    names: list[str],
    *,
    repository: str,
    tag: str,
    commit: str,
) -> tuple[str, ...]:
    """Write SHA256SUMS for the two final native setup files."""
    identity = Identity(_repository(repository), _tag(tag), _sha(commit))
    project_name, version = _project()
    if identity.tag != f"v{version}":
        raise ReleaseError("Project version does not match the release tag.")
    complete = [*names, CHECKSUMS_NAME]
    app_id = _project_app_id(project_name)
    try:
        expected_asset_names(complete, app_id=app_id)
        if directory.is_symlink() or {
            entry.name for entry in directory.iterdir()
        } - set(complete):
            raise ReleaseError(
                "Staging directory contains unexpected release files."
            )
        payload: dict[str, bytes] = {}
        for filename in names:
            path = directory / filename
            if not path.is_file() or path.is_symlink():
                raise ReleaseError(
                    f"Release asset is not a regular file: {filename}."
                )
            payload[filename] = path.read_bytes()
        checksums = checksum_bytes(payload, app_id=app_id)
    except ValueError as error:
        raise ReleaseError(str(error)) from error
    (directory / CHECKSUMS_NAME).write_bytes(checksums)
    _validate_local_files(directory, complete, identity)
    return tuple(sorted(complete))


def _asset_bytes(
    api: Api, identity: Identity, asset: dict[str, object]
) -> bytes:
    asset_id = asset.get("id")
    if not isinstance(asset_id, int) or isinstance(asset_id, bool):
        raise ReleaseError("GitHub asset has an invalid identifier.")
    return api.request(
        "GET",
        _endpoint(identity.repository, f"releases/assets/{asset_id}"),
        headers=("Accept: application/octet-stream",),
    )


def _delete_asset(api: Api, identity: Identity, asset_id: int) -> None:
    _tag_commit(api, identity)
    api.request(
        "DELETE", _endpoint(identity.repository, f"releases/assets/{asset_id}")
    )


def _upload(
    api: Api, identity: Identity, release_id: int, name: str, data: bytes
) -> None:
    _tag_commit(api, identity)
    encoded = __import__("urllib.parse", fromlist=["quote"]).quote(
        name, safe=""
    )
    api.request(
        "POST",
        (
            f"https://uploads.github.com/repos/{identity.repository}/"
            f"releases/{release_id}/assets?name={encoded}"
        ),
        data=data,
        headers=(
            "Content-Type: application/octet-stream",
            f"Content-Length: {len(data)}",
        ),
    )


def _sync_asset(
    api: Api,
    identity: Identity,
    release: dict[str, object],
    name: str,
    data: bytes,
) -> None:
    assets = _assets(release)
    existing = assets.get(name)
    if existing is not None:
        digest = existing.get("digest")
        if (
            isinstance(digest, str)
            and digest.startswith("sha256:")
            and digest[7:] == _sha256(data)
        ):
            return
        remote = _asset_bytes(api, identity, existing)
        if remote == data:
            return
        _delete_asset(api, identity, _asset_id(existing))
    _upload(api, identity, _release_id(release), name, data)
    updated = _release(api, identity)
    uploaded = _assets(updated).get(name)
    if uploaded is None:
        raise ReleaseError(f"GitHub did not retain uploaded asset {name}.")
    digest = uploaded.get("digest")
    expected_digest = _sha256(data)
    if isinstance(digest, str) and digest.startswith("sha256:"):
        if digest[7:] != expected_digest:
            raise ReleaseError(
                f"GitHub stored an incorrect digest for uploaded asset {name}."
            )
    elif _asset_bytes(api, identity, uploaded) != data:
        raise ReleaseError(
            f"GitHub stored different bytes for uploaded asset {name}."
        )


def _asset_id(asset: dict[str, object]) -> int:
    value = asset.get("id")
    if not isinstance(value, int) or isinstance(value, bool) or value <= 0:
        raise ReleaseError("GitHub asset has an invalid identifier.")
    return value


def prepare(
    api: Api, repository: str, tag: str, commit: str, notes: Path
) -> dict[str, object]:
    """Validate checked metadata and create or reuse only its draft release."""
    identity = Identity(_repository(repository), _tag(tag), _sha(commit))
    if not notes.is_file() or notes.is_symlink():
        raise ReleaseError("Release notes must be a regular file.")
    distribution, current_version = _project()
    version = identity.tag[1:]
    channel = release_channel(version)
    validate_tag_version(identity.tag, current_version)
    _tag_commit(api, identity)
    try:
        release = _release(api, identity)
    except _ReleaseNotFound:
        _tag_commit(api, identity)
        release = _json(
            api,
            "POST",
            _endpoint(identity.repository, "releases"),
            {
                "tag_name": identity.tag,
                "target_commitish": identity.commit,
                "name": f"{distribution} {version}",
                "body": notes.read_text(encoding="utf-8"),
                "draft": True,
                "prerelease": channel != "stable",
            },
        )
        if not isinstance(release, dict):
            raise ReleaseError(
                "GitHub did not return the created draft release."
            )
    if (
        release.get("draft") is not True
        or release.get("tag_name") != identity.tag
    ):
        raise ReleaseError("Prepared release is not the requested tag's draft.")
    if release.get("target_commitish") != identity.commit:
        raise ReleaseError("Draft release has an inconsistent target commit.")
    if release.get("prerelease") is not (channel != "stable"):
        raise ReleaseError(
            "Prepared release does not match its release channel."
        )
    return release


def upload(
    api: Api,
    repository: str,
    tag: str,
    commit: str,
    directory: Path,
    names: list[str],
) -> None:
    identity = Identity(_repository(repository), _tag(tag), _sha(commit))
    _tag_commit(api, identity)
    files = _validate_local_files(directory, names, identity)
    release = _release(api, identity)
    existing = _assets(release)
    if set(existing) - set(files):
        raise ReleaseError(
            "Draft contains unexpected assets; refusing to replace or delete them."
        )
    for name, data in files.items():
        _sync_asset(api, identity, release, name, data)
        release = _release(api, identity)


def finalize(
    api: Api,
    repository: str,
    tag: str,
    commit: str,
    *,
    expected: dict[str, bytes] | None = None,
) -> None:
    """Validate native setup assets and SHA256SUMS, then publish the draft."""
    identity = Identity(_repository(repository), _tag(tag), _sha(commit))
    _tag_commit(api, identity)
    release = _release(api, identity)
    assets = _assets(release)
    names = set(assets)
    _check_asset_names(list(names))
    with tempfile.TemporaryDirectory(
        prefix="buildben-release-finalize-"
    ) as temp:
        directory = Path(temp)
        for name, asset in assets.items():
            asset_basename(name, "GitHub asset name")
            (directory / name).write_bytes(_asset_bytes(api, identity, asset))
        files = _validate_local_files(directory, sorted(names), identity)
        if expected is not None and files != expected:
            raise ReleaseError("Draft assets do not match the local bundle.")
        if set(files) != names:
            raise ReleaseError("Draft asset set changed during finalization.")
    _tag_commit(api, identity)
    api.request(
        "PATCH",
        _endpoint(identity.repository, f"releases/{_release_id(release)}"),
        data=json.dumps(
            {
                "draft": False,
                "prerelease": release_channel(tag[1:]) != "stable",
            },
            separators=(",", ":"),
        ).encode(),
    )


def _prune(api: Api, identity: Identity) -> None:
    channel = release_channel(identity.tag[1:])
    if channel == "stable":
        return
    previews: list[tuple[datetime, int, str]] = []
    for release in _list_releases(api, identity.repository):
        tag = release.get("tag_name")
        if (
            release.get("draft") is not False
            or release.get("prerelease") is not True
            or not isinstance(tag, str)
            or not tag.startswith("v")
            or not VERSION_RE.fullmatch(tag[1:])
            or release_channel(tag[1:]) != channel
        ):
            continue
        published = release.get("published_at")
        if not isinstance(published, str):
            raise ReleaseError(f"Preview {tag} has no publication timestamp.")
        try:
            timestamp = datetime.fromisoformat(published)
        except ValueError as exc:
            raise ReleaseError(
                f"Preview {tag} has an invalid publication timestamp."
            ) from exc
        if timestamp.tzinfo is None:
            raise ReleaseError(f"Preview {tag} has no publication timezone.")
        previews.append((timestamp, _release_id(release), tag))
    if len({tag for _, _, tag in previews}) != len(previews):
        raise ReleaseError("Release listing contains duplicate preview tags.")
    for timestamp, release_id, tag in sorted(previews, reverse=True)[3:]:
        endpoint = _endpoint(identity.repository, f"releases/{release_id}")
        current = _json(api, "GET", endpoint)
        if (
            not isinstance(current, dict)
            or current.get("id") != release_id
            or current.get("tag_name") != tag
            or current.get("draft") is not False
            or current.get("prerelease") is not True
            or not isinstance(published := current.get("published_at"), str)
            or datetime.fromisoformat(published) != timestamp
        ):
            raise ReleaseError(f"Preview {tag} changed during retention.")
        # > Delete the release record only. Its Git tag remains in the repository.
        api.request("DELETE", endpoint)


def publish(
    api: Api,
    repository: str,
    tag: str,
    commit: str,
    directory: Path,
    notes: Path,
) -> None:
    """Publish the verified local bundle and resume safely after an interruption."""
    identity = Identity(_repository(repository), _tag(tag), _sha(commit))
    names = sorted(entry.name for entry in directory.iterdir())
    files = _validate_local_files(directory, names, identity)
    _tag_commit(api, identity)
    try:
        release = _release(api, identity, allow_published=True)
    except _ReleaseNotFound:
        release = prepare(api, repository, tag, commit, notes)
    if release.get("draft") is False:
        assets = _assets(release)
        if set(assets) != set(files) or any(
            _asset_bytes(api, identity, assets[name]) != data
            for name, data in files.items()
        ):
            raise ReleaseError(
                f"Published release {tag} conflicts with the local bundle."
            )
    else:
        upload(api, repository, tag, commit, directory, names)
        finalize(api, repository, tag, commit, expected=files)
    print(f"GitHub release {tag} is published.")
    try:
        _prune(api, identity)
    except (OSError, ReleaseError, ValueError) as exc:
        print(
            f"Warning: {tag} is published, but preview retention failed: {exc}",
            file=sys.stderr,
        )
        print(f"Retry with: just release-push {tag}", file=sys.stderr)


def wait_ci(
    api: Api,
    repository: str,
    tag: str,
    commit: str,
    *,
    timeout: float = 120.0,
    interval: float = 5.0,
    clock=time.monotonic,
    sleep=time.sleep,
) -> int:
    """Wait for the exact successful tag CI run."""
    identity = Identity(_repository(repository), _tag(tag), _sha(commit))
    deadline = clock() + timeout
    run_id: int | None = None
    while clock() < deadline:
        endpoint = _endpoint(
            identity.repository,
            (
                f"actions/workflows/ci.yml/runs?head_sha={identity.commit}&per_page=100"
            ),
        )
        data = _json(api, "GET", endpoint)
        if not isinstance(data, dict) or not isinstance(
            data.get("workflow_runs"), list
        ):
            raise ReleaseError("GitHub returned malformed CI workflow runs.")
        candidates: list[dict[str, object]] = []
        for run in data["workflow_runs"]:
            run_repository = (
                run.get("repository") if isinstance(run, dict) else None
            )
            head_repository = (
                run.get("head_repository") if isinstance(run, dict) else None
            )
            if (
                not isinstance(run, dict)
                or run.get("head_sha") != identity.commit
                or run.get("path") != ".github/workflows/ci.yml"
            ):
                continue
            if (
                not isinstance(run_repository, dict)
                or run_repository.get("full_name") != identity.repository
                or not isinstance(head_repository, dict)
                or head_repository.get("full_name") != identity.repository
            ):
                continue
            allowed_push = (
                run.get("event") == "push"
                and run.get("head_branch") == identity.tag
            )
            allowed_dispatch = (
                run.get("event") == "workflow_dispatch"
                and run.get("head_branch") == identity.tag
            )
            if allowed_push or allowed_dispatch:
                candidates.append(run)
        if candidates:
            candidates.sort(
                key=lambda run: (
                    str(run.get("created_at", "")),
                    run.get("run_number", 0)
                    if isinstance(run.get("run_number"), int)
                    else 0,
                ),
                reverse=True,
            )
            value = candidates[0].get("id")
            if (
                isinstance(value, int)
                and not isinstance(value, bool)
                and value > 0
            ):
                run_id = value
                break
        sleep(min(interval, max(0.0, deadline - clock())))
    if run_id is None:
        raise ReleaseError(
            f"No matching ci.yml run for {identity.commit} was found within "
            f"{timeout:g}s. Dispatch ci.yml for immutable tag {identity.tag}, "
            "then rerun the release gate."
        )
    status = api.watch_ci(identity.repository, run_id)
    if status:
        raise ReleaseError(
            f"Matching CI run {run_id} failed, was cancelled, or timed out "
            f"(gh run watch exit {status})."
        )
    return run_id


def _release_dependency_state(revision: str) -> tuple[object, ...]:
    """Read the dependency declarations with only the project version removed."""

    def read_toml(path: str) -> dict[str, object]:
        return tomllib.loads(
            subprocess.check_output(
                ["git", "show", f"{revision}:{path}"], text=True
            )
        )

    metadata = read_toml("pyproject.toml")
    project = metadata.get("project")
    if not isinstance(project, dict):
        raise ReleaseError("Versioned project metadata is missing.")
    project.pop("version", None)
    lock = read_toml("uv.lock")
    packages = lock.get("package")
    if not isinstance(packages, list):
        raise ReleaseError("uv.lock has no package list.")
    for package in packages:
        if (
            isinstance(package, dict)
            and package.get("name") == project.get("name")
            and package.get("source") in ({"editable": "."}, {"virtual": "."})
        ):
            package.pop("version", None)
    return metadata, lock, read_toml("pylock.toml")


def require_rc_evidence(api: Api, identity: Identity) -> None:
    """Require successful CI on the newest equivalent candidate from this cycle."""
    if release_channel(identity.tag[1:]) != "stable":
        raise ReleaseError(
            "Candidate evidence applies only to a stable release."
        )
    tags = subprocess.check_output(
        [
            "git",
            "tag",
            "--merged",
            identity.commit,
            "--list",
            f"{identity.tag}rc*",
        ],
        text=True,
    ).splitlines()
    candidates = [
        (int(match[2]), tag)
        for tag in tags
        if (match := VERSION_RE.fullmatch(tag[1:])) and match[1] == "rc"
    ]
    if not candidates:
        raise ReleaseError(
            "No release candidate exists for this stable version."
        )
    _, tag = max(candidates)
    commit = subprocess.check_output(
        ["git", "rev-parse", f"refs/tags/{tag}^{{commit}}"], text=True
    ).strip()
    if subprocess.run(
        [
            "git",
            "diff",
            "--quiet",
            commit,
            identity.commit,
            "--",
            ".",
            ":!CHANGELOG.md",
            ":!pyproject.toml",
            ":!uv.lock",
            ":!pylock.toml",
        ],
        check=False,
    ).returncode or _release_dependency_state(
        commit
    ) != _release_dependency_state(identity.commit):
        raise ReleaseError(
            "Source or dependencies changed since the release candidate."
        )
    candidate = Identity(identity.repository, tag, commit)
    _tag_commit(api, candidate)
    data = _json(
        api,
        "GET",
        _endpoint(
            identity.repository,
            f"actions/workflows/ci.yml/runs?head_sha={commit}",
        ),
    )
    if isinstance(data, dict) and isinstance(
        runs := data.get("workflow_runs"), list
    ):
        for run in runs:
            if (
                isinstance(run, dict)
                and run.get("head_sha") == commit
                and run.get("head_branch") == tag
                and run.get("event") in {"push", "workflow_dispatch"}
                and run.get("conclusion") == "success"
            ):
                return
    raise ReleaseError(f"No successful candidate CI found for {tag}.")


def verify_pypi_packages(
    api: Api,
    repository: str,
    tag: str,
    commit: str,
    *,
    metadata: Path,
    directory: Path,
) -> tuple[str, ...]:
    """Validate the stable release's captured wheel and source archive."""
    identity = Identity(_repository(repository), _tag(tag), _sha(commit))
    _tag_commit(api, identity)
    release = json.loads(metadata.read_bytes())
    if (
        not isinstance(release, dict)
        or release.get("tag_name") != tag
        or release.get("draft") is not False
        or release.get("prerelease") is not False
        or release_channel(identity.tag[1:]) != "stable"
    ):
        raise ReleaseError(
            "Manual publication requires the exact non-draft release."
        )
    project_name, version = _project()
    if identity.tag != f"v{version}":
        raise ReleaseError("Project version does not match the release tag.")
    if directory.is_symlink() or not directory.is_dir():
        raise ReleaseError("PyPI input directory is missing or linked.")
    packages = tuple(
        sorted(
            path.name
            for path in directory.iterdir()
            if path.name != ".gitignore"
        )
    )
    wheels = [name for name in packages if name.endswith(".whl")]
    sdists = [name for name in packages if name.endswith(".tar.gz")]
    if len(packages) != 2 or len(wheels) != 1 or len(sdists) != 1:
        raise ReleaseError(
            "PyPI input must contain exactly one wheel and one source archive."
        )
    assets = _assets(release)
    if {name for name in assets if name.endswith((".whl", ".tar.gz"))} != set(
        packages
    ):
        raise ReleaseError(
            "PyPI input does not match the published package inventory."
        )
    for filename in packages:
        path = directory / filename
        if not path.is_file() or path.is_symlink():
            raise ReleaseError(
                f"PyPI package is not a regular file: {filename}."
            )
        content = path.read_bytes()
        _validate_package(path, project_name, version, content)
        asset = assets[filename]
        digest = asset.get("digest")
        if isinstance(digest, str) and digest.startswith("sha256:"):
            matches = digest[7:] == _sha256(content)
        else:
            matches = content == _asset_bytes(api, identity, asset)
        if not matches:
            raise ReleaseError(
                f"PyPI input differs from the published asset: {filename}"
            )

    _tag_commit(api, identity)
    return packages


def smoke(
    directory: Path,
    identity: Identity,
    *,
    python: str,
    previous: Path | None = None,
) -> None:
    """Install and invoke the actual published wheel or Linux setup."""
    names = sorted(entry.name for entry in directory.iterdir())
    _validate_local_files(directory, names, identity)
    with Path("pyproject.toml").open("rb") as stream:
        metadata = tomllib.load(stream)
    distribution, _version = _project()
    app_id = _project_app_id(distribution)
    command = (
        metadata.get("tool", {})
        .get("apprc", {})
        .get("distribution", {})
        .get("command-name")
    )
    if not isinstance(command, str):
        scripts = metadata["project"].get("scripts", {})
        command = next(iter(scripts), None)
    if not isinstance(command, str):
        raise ReleaseError("Project has no command for the release smoke.")
    asset_basename(command, "Project command name")
    with tempfile.TemporaryDirectory(prefix="release-smoke-") as temporary:
        root = Path(temporary)
        environment = os.environ.copy()
        for name in ("VIRTUAL_ENV", "UV_PROJECT", "UV_PROJECT_ENVIRONMENT"):
            environment.pop(name, None)
        for name, folder in (
            ("HOME", "home"),
            ("XDG_DATA_HOME", "data"),
            ("XDG_CONFIG_HOME", "config"),
            ("XDG_CACHE_HOME", "cache"),
            ("XDG_STATE_HOME", "state"),
            ("UV_TOOL_BIN_DIR", "bin"),
            ("UV_TOOL_DIR", "uv-tools"),
            ("TMPDIR", "tmp"),
        ):
            (root / folder).mkdir()
            environment[name] = str(root / folder)

        def run(arguments: list[str]) -> None:
            subprocess.run(arguments, cwd=root, env=environment, check=True)

        native_name = f"{app_id}-setup-linux-x86_64"
        if native_name in names:
            if previous is not None:
                validate_directory(previous, app_id=app_id)
            setups = [directory] if previous is None else [previous, directory]
            for setup_dir in setups:
                setup = (setup_dir / native_name).resolve()
                setup.chmod(0o755)
                run(
                    [
                        str(setup),
                        "app",
                        "install",
                        "--yes",
                        "--command-directory",
                        str(root / "bin"),
                    ]
                )
            installed = str(root / "bin" / command)
            run([installed, "--help"])
            run([installed, "app", "uninstall", "--yes"])
        for name in _package_names(names):
            if name.endswith(".whl"):
                wheel = (directory / name).resolve()
                run(["uv", "venv", "--python", python, str(root / "venv")])
                run(
                    [
                        "uv",
                        "pip",
                        "install",
                        "--python",
                        str(root / "venv/bin/python"),
                        str(wheel),
                    ]
                )
                run([str(root / "venv/bin" / command), "--help"])


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Prepare and publish validated GitHub release assets."
    )
    subparsers = parser.add_subparsers(dest="command", required=True)
    prepare_parser = subparsers.add_parser("prepare")
    prepare_parser.add_argument("--repository", required=True)
    prepare_parser.add_argument("--tag", required=True)
    prepare_parser.add_argument("--commit", required=True)
    prepare_parser.add_argument("--notes", type=Path, required=True)
    item = subparsers.add_parser("upload")
    item.add_argument("--repository", required=True)
    item.add_argument("--tag", required=True)
    item.add_argument("--commit", required=True)
    item.add_argument("--directory", type=Path, required=True)
    item.add_argument("--files", nargs="+", required=True)
    for verb in ("finalize", "wait-ci", "rc-evidence"):
        item = subparsers.add_parser(verb)
        item.add_argument("--repository", required=True)
        item.add_argument("--tag", required=True)
        item.add_argument("--commit", required=True)
    for verb in ("stage", "verify", "verify-pypi"):
        item = subparsers.add_parser(verb)
        item.add_argument("--repository", required=True)
        item.add_argument("--tag", required=True)
        item.add_argument("--commit", required=True)
        item.add_argument("--directory", type=Path, required=True)
        if verb == "stage":
            item.add_argument("--files", nargs="+", required=True)
        elif verb == "verify-pypi":
            item.add_argument("--metadata", type=Path, required=True)
    publish_parser = subparsers.add_parser("publish")
    publish_parser.add_argument("--repository", required=True)
    publish_parser.add_argument("--tag", required=True)
    publish_parser.add_argument("--commit", required=True)
    publish_parser.add_argument("--directory", type=Path, required=True)
    publish_parser.add_argument("--notes", type=Path, required=True)
    smoke_parser = subparsers.add_parser("smoke")
    smoke_parser.add_argument("--repository", required=True)
    smoke_parser.add_argument("--tag", required=True)
    smoke_parser.add_argument("--commit", required=True)
    smoke_parser.add_argument("--directory", type=Path, required=True)
    smoke_parser.add_argument("--python", default="3.12")
    smoke_parser.add_argument("--previous", type=Path)
    return parser


def main(argv: list[str] | None = None, *, api: Api | None = None) -> int:
    args = _parser().parse_args(argv)
    client = api or GitHubApi()
    try:
        if args.command == "stage":
            names = stage(
                args.directory,
                args.files,
                repository=args.repository,
                tag=args.tag,
                commit=args.commit,
            )
            print("\n".join(names))
        elif args.command == "verify":
            identity = Identity(
                _repository(args.repository), _tag(args.tag), _sha(args.commit)
            )
            payload = _validate_local_files(
                args.directory,
                sorted(entry.name for entry in args.directory.iterdir()),
                identity,
            )
            print("\n".join(sorted(payload)))
        elif args.command == "verify-pypi":
            verify_pypi_packages(
                client,
                args.repository,
                args.tag,
                args.commit,
                metadata=args.metadata,
                directory=args.directory,
            )
            print("Verified separate wheel/sdist PyPI input.")
        elif args.command == "prepare":
            release = prepare(
                client, args.repository, args.tag, args.commit, args.notes
            )
            print(
                f"Prepared draft release {args.tag} (id {_release_id(release)})."
            )
        elif args.command == "upload":
            upload(
                client,
                args.repository,
                args.tag,
                args.commit,
                args.directory,
                args.files,
            )
        elif args.command == "publish":
            publish(
                client,
                args.repository,
                args.tag,
                args.commit,
                args.directory,
                args.notes,
            )
        elif args.command == "smoke":
            identity = Identity(
                _repository(args.repository), _tag(args.tag), _sha(args.commit)
            )
            smoke(
                args.directory,
                identity,
                python=args.python,
                previous=args.previous,
            )
        elif args.command == "rc-evidence":
            require_rc_evidence(
                client,
                Identity(
                    _repository(args.repository),
                    _tag(args.tag),
                    _sha(args.commit),
                ),
            )
        elif args.command == "finalize":
            finalize(client, args.repository, args.tag, args.commit)
        else:
            run_id = wait_ci(client, args.repository, args.tag, args.commit)
            print(f"Required CI run {run_id} passed.")
    except (
        ReleaseError,
        OSError,
        subprocess.SubprocessError,
        ValueError,
    ) as exc:
        print(f"release-assets: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
