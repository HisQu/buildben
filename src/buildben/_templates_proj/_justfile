[private]
_ci-check-python version environment:
    #!/usr/bin/env bash
    set -euo pipefail
    export UV_PROJECT_ENVIRONMENT="{{environment}}"
    export UV_LINK_MODE=copy
    unset VIRTUAL_ENV
    echo "Python {{version}}: preparing isolated release environment..."
    uv sync --python "{{version}}" --locked --all-extras --all-groups --quiet --no-progress
    uv lock --check --quiet
    echo "Python {{version}}: environment ready; running checks."
    uv run --python "{{version}}" --locked --no-sync ruff format . --check
    uv run --python "{{version}}" --locked --no-sync ruff check .
    uv run --python "{{version}}" --locked --no-sync pyright --venvpath "$(dirname "$UV_PROJECT_ENVIRONMENT")"
    uv run --python "{{version}}" --locked --no-sync pytest
    uv run --python "{{version}}" --locked --no-sync python -m compileall -q src tests
    echo "Python {{version}}: checks passed."

[private]
_release-artifact-check notes_output build_only="false" notes_input="":
    #!/usr/bin/env bash
    set -euo pipefail
    version="$(uv version --short)"
    identity_args=(--project-version "$version")
    notes_args=()
    if [[ "${GITHUB_REF_TYPE:-}" == "tag" ]]; then
        identity_args+=(--tag "${GITHUB_REF_NAME:?GITHUB_REF_NAME is required for tag builds.}")
    elif [[ "{{build_only}}" == "true" ]]; then
        notes_args+=(--allow-unreleased-entries)
    fi
    notes_output="{{notes_output}}"
    notes_input={{quote(notes_input)}}
    rm -rf dist
    mkdir -p "$(dirname "$notes_output")"
    if [[ -n "$notes_input" ]]; then
        if [[ ! -f "$notes_input" ]]; then
            echo "Release notes input must be a regular file: $notes_input" >&2
            exit 1
        fi
        PYTHONPATH=src python -c 'import sys; from {my_project}_dev.packaging.release_notes import validate_version; validate_version(sys.argv[1])' "$version"
        if [[ "${GITHUB_REF_TYPE:-}" == "tag" ]]; then
            PYTHONPATH=src python -c 'import sys; from {my_project}_dev.packaging.release_notes import validate_tag_version; validate_tag_version(*sys.argv[1:])' "$GITHUB_REF_NAME" "$version"
        fi
        cp -- "$notes_input" "$notes_output"
    else
        python src/{my_project}_dev/packaging/release_notes.py "$version" "${identity_args[@]}" "${notes_args[@]}" --output "$notes_output"
    fi
    uv build --python 3.12 --no-sources --no-build-logs
    shopt -s nullglob
    wheels=(dist/*.whl)
    sdists=(dist/*.tar.gz)
    if [[ "${#wheels[@]}" -ne 1 || "${#sdists[@]}" -ne 1 ]]; then
        echo "Expected exactly one wheel and one sdist in dist/." >&2
        exit 1
    fi
    if [[ "$(basename "${wheels[0]}")" != {my_project}-${version}-*.whl ]]; then
        echo "Expected a wheel for ${version}." >&2
        exit 1
    fi
    if [[ "$(basename "${sdists[0]}")" != "{my_project}-${version}.tar.gz" ]]; then
        echo "Expected sdist {my_project}-${version}.tar.gz." >&2
        exit 1
    fi
    uv run --with twine --no-project -- twine check "${wheels[0]}" "${sdists[0]}"

# Build standard wheel and sdist once without running the full source matrix.
build-release-inputs notes_file="":
    #!/usr/bin/env bash
    set -euo pipefail
    just _check-uv
    uv lock --check
    just _release-artifact-check dist/release-notes.md true {{quote(notes_file)}}

# Smoke one built wheel in an isolated Python 3.12 tool environment.
release-wheel-smoke:
    #!/usr/bin/env bash
    set -euo pipefail
    shopt -s nullglob
    wheels=(dist/*.whl)
    if [[ "${#wheels[@]}" -ne 1 ]]; then echo "Expected exactly one wheel in dist/." >&2; exit 1; fi
    version="$(uv version --short)"
    wheel="$(realpath "${wheels[0]}")"
    artifact_uri="$(python -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve().as_uri())' "$wheel")"
    smoke_script="$(realpath src/{my_project}_dev/packaging/install_smoke.py)"
    smoke_root="$(mktemp -d)"
    trap 'rm -rf "$smoke_root"' EXIT
    (cd "$smoke_root"; uv run --isolated --python 3.12 --with "{my_project} @ $artifact_uri" python "$smoke_script" --expected-version "$version")

# Install a generated project's real sdist in an isolated uv tool environment.
release-install-smoke:
    #!/usr/bin/env bash
    set -euo pipefail
    just build-release-inputs
    shopt -s nullglob
    sdists=(dist/*.tar.gz)
    if [[ "${#sdists[@]}" -ne 1 ]]; then echo "Expected exactly one source archive in dist/." >&2; exit 1; fi
    version="$(uv version --short)"
    smoke_root="$(mktemp -d)"
    trap 'rm -rf "$smoke_root"' EXIT
    export HOME="$smoke_root/home"
    export XDG_CONFIG_HOME="$smoke_root/config"
    export XDG_DATA_HOME="$smoke_root/data"
    export XDG_CACHE_HOME="$smoke_root/cache"
    export UV_CACHE_DIR="$smoke_root/uv-cache"
    export UV_TOOL_DIR="$smoke_root/uv-tools"
    export UV_TOOL_BIN_DIR="$smoke_root/uv-bin"
    source_root="$smoke_root/source"
    mkdir -p "$HOME" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$source_root"
    tool_dir_fs="$UV_TOOL_DIR"
    if command -v cygpath >/dev/null 2>&1; then
        export UV_TOOL_DIR="$(cygpath -m "$UV_TOOL_DIR")"
        export UV_TOOL_BIN_DIR="$(cygpath -m "$UV_TOOL_BIN_DIR")"
        export UV_CACHE_DIR="$(cygpath -m "$UV_CACHE_DIR")"
        tool_dir_fs="$(cygpath -u "$UV_TOOL_DIR")"
    fi
    config_sentinel="$XDG_CONFIG_HOME/{my_project}-sentinel"
    data_sentinel="$XDG_DATA_HOME/{my_project}-sentinel"
    printf 'preserve config\n' > "$config_sentinel"
    printf 'preserve data\n' > "$data_sentinel"
    tar -xzf "${sdists[0]}" -C "$source_root"
    project_root="$(find "$source_root" -mindepth 1 -maxdepth 1 -type d -print -quit)"
    if [[ ! -f "$project_root/pyproject.toml" || ! -f "$project_root/uv.lock" ]]; then
        echo "Generated source archive must contain pyproject.toml and uv.lock." >&2
        exit 1
    fi
    runtime_requirements="$smoke_root/runtime-requirements.txt"
    (
        cd "$project_root"
        uv export --locked --no-dev --no-default-groups --no-emit-project --format requirements.txt --output-file "$runtime_requirements"
        uv tool install --force --refresh --python "$(command -v python)" --with-requirements "$runtime_requirements" "$project_root"
    )
    export PATH="$UV_TOOL_BIN_DIR:$PATH"
    tool_project="{my_project}"
    tool_env="$tool_dir_fs/$tool_project"
    if [[ ! -d "$tool_env" ]]; then
        tool_env="$tool_dir_fs/${tool_project//_/-}"
    fi
    if [[ -x "$tool_env/Scripts/python.exe" ]]; then
        tool_python="$tool_env/Scripts/python.exe"
        tool_bin="$(cygpath -u "$UV_TOOL_BIN_DIR")"
        "$tool_bin/{my_project}.exe" --help
        "$tool_bin/bube.exe" config setup --help
    else
        tool_python="$tool_env/bin/python"
        "$UV_TOOL_BIN_DIR/{my_project}" --help
        "$UV_TOOL_BIN_DIR/bube" config setup --help
    fi
    "$tool_python" -m {my_project}_dev.packaging.install_smoke --expected-version "$version"
    test "$(cat "$config_sentinel")" = "preserve config"
    test "$(cat "$data_sentinel")" = "preserve data"
    uv tool uninstall "{my_project}"
    test "$(cat "$config_sentinel")" = "preserve config"
    test "$(cat "$data_sentinel")" = "preserve data"

# Rehearse the release gate. It does not upload anything.
release-check:
    #!/usr/bin/env bash
    set -euo pipefail
    just _check-uv
    check_root="$(mktemp -d)"
    trap 'rm -rf "$check_root"' EXIT
    current_version="$(uv version --short)"
    prepared_version="$(PYTHONPATH=src python -c 'from pathlib import Path; from {my_project}_dev.packaging.release_notes import latest_release_version; print(latest_release_version(Path("CHANGELOG.md").read_text(encoding="utf-8")))')"
    if [[ "${PROJECT_RELEASE_IN_PROGRESS:-}" != 1 && "$prepared_version" != "$current_version" ]]; then
        PYTHONPATH=src python -c 'import sys; from {my_project}_dev.packaging.release_notes import validate_next_version; validate_next_version(*sys.argv[1:])' "$current_version" "$prepared_version"
        version_root="$check_root/version"
        mkdir -p "$version_root"
        cp pyproject.toml uv.lock pylock.toml "$version_root/"
        restore_version_files=true
        cleanup() { exit_code=$?; trap - EXIT; if [[ "$restore_version_files" == true ]]; then cp "$version_root/pyproject.toml" pyproject.toml; cp "$version_root/uv.lock" uv.lock; cp "$version_root/pylock.toml" pylock.toml; fi; rm -rf "$check_root"; exit "$exit_code"; }
        trap cleanup EXIT
        uv version "$prepared_version" --no-sync
        uv export -o pylock.toml --all-extras --all-groups --quiet
        PROJECT_RELEASE_IN_PROGRESS=1 just release-check
        exit $?
    fi
    for python_version in 3.12 3.13; do just _ci-check-python "$python_version" "$check_root/python-${python_version}/.venv"; done
    just _release-artifact-check "$check_root/release-notes.md"
    if [[ "${PROJECT_RELEASE_IN_PROGRESS:-}" == 1 ]]; then
        echo "Local release rehearsal passed; nothing was published."
    else
        echo "Next step: run just release <patch|minor|major>."
    fi

# Prepare a checked version commit and annotated local release tag.
release-prepare level="patch":
    #!/usr/bin/env bash
    set -euo pipefail
    just _check-uv
    just _check-clean-worktree "preparing the release"
    next_version="$(uv version --bump "{{level}}" --dry-run --short)"
    tag="v${next_version}"
    if git rev-parse --verify --quiet "refs/tags/${tag}" >/dev/null; then
        echo "Tag ${tag} already exists. Choose another release level." >&2
        exit 1
    fi

    echo "Preparing ${tag} locally. Nothing will upload until you push main and ${tag}."
    release_root="$(mktemp -d)"
    notes_file="$release_root/release-notes.md"
    restore_version_files=false
    cleanup() { exit_code=$?; trap - EXIT; if [[ "$restore_version_files" == true ]]; then cp "$release_root/pyproject.toml" pyproject.toml; cp "$release_root/uv.lock" uv.lock; cp "$release_root/pylock.toml" pylock.toml; fi; rm -rf "$release_root"; exit "$exit_code"; }
    trap cleanup EXIT
    python src/{my_project}_dev/packaging/release_notes.py "$next_version" --output "$notes_file"
    cp pyproject.toml uv.lock pylock.toml "$release_root/"
    restore_version_files=true
    uv version --bump "{{level}}" --no-sync
    uv export -o pylock.toml --all-extras --all-groups --quiet
    uv lock --check
    just _release-artifact-check "$notes_file"
    git commit --only pyproject.toml uv.lock pylock.toml -m "Bump version to ${next_version}"
    restore_version_files=false
    if ! git tag -a "$tag" -m "Release ${tag}"; then
        echo "Version commit succeeded, but tag creation failed. Retry with:" >&2
        echo "git tag -a ${tag} -m 'Release ${tag}'" >&2
        exit 1
    fi

    echo
    echo "================================================================="
    echo "✅  RELEASE ${tag} PREPARED LOCALLY"
    echo "================================================================="
    echo
    echo "Nothing has been uploaded."
    echo
    echo "NEXT COMMAND, THIS STARTS THE RELEASE:"
    echo
    echo "  just release-push ${tag}"
    echo
    echo "GitHub will run CI, validate wheel and sdist artifacts, and create"
    echo "the GitHub Release. PyPI follows RELEASE_PYPI in the tagged justfile."
    echo "================================================================="

# Push a prepared release commit and tag as one remote operation.
release-push tag:
    #!/usr/bin/env bash
    set -euo pipefail
    just _check-clean-worktree "pushing the release"
    tag="{{ tag }}"

    if [[ ! "$tag" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
        echo "Invalid release tag '${tag}'; expected vMAJOR.MINOR.PATCH." >&2
        exit 1
    fi
    if [[ "$(git branch --show-current)" != "main" ]]; then
        echo "Release pushes must run from the main branch." >&2
        exit 1
    fi
    if ! git cat-file -e "refs/tags/${tag}^{tag}" 2>/dev/null; then
        echo "Annotated local tag ${tag} does not exist." >&2
        exit 1
    fi
    if [[ "$(git rev-list -n 1 "refs/tags/${tag}")" != "$(git rev-parse --verify --end-of-options 'HEAD^{commit}')" ]]; then
        echo "Tag ${tag} does not point to the current main commit." >&2
        exit 1
    fi
    release_pypi="$(just _committed-release-pypi-policy "$tag")"

    echo "Pushing main and ${tag} atomically. RELEASE_PYPI=${release_pypi}."
    if ! git push --atomic origin refs/heads/main:refs/heads/main "refs/tags/${tag}:refs/tags/${tag}"; then
        echo "The remote push failed. The release remains prepared locally." >&2
        echo "Retry with: just release-push ${tag}" >&2
        exit 1
    fi
    echo "GitHub Actions will create the release. This command does not wait for it."
    if [[ "$release_pypi" == "true" ]]; then
        echo "If PyPI publication needs a retry, run: just publish-pypi ${tag}"
    else
        echo "PyPI publication is disabled by RELEASE_PYPI in the tagged justfile."
    fi

# Prepare and push a release. GitHub Actions owns artifact publication.
release level="patch":
    #!/usr/bin/env bash
    set -euo pipefail
    just release-prepare "{{ level }}"
    tag="v$(uv version --short)"
    if ! just release-push "$tag"; then
        echo "Release ${tag} remains prepared locally." >&2
        echo "Retry with: just release-push ${tag}" >&2
        exit 1
    fi

# Publish the artifacts attached to an existing GitHub Release.
publish-pypi tag:
    #!/usr/bin/env bash
    set -euo pipefail
    tag="{{ tag }}"

    if [[ ! "$tag" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
        echo "Invalid release tag '${tag}'; expected vMAJOR.MINOR.PATCH." >&2
        exit 1
    fi
    current_release_pypi="$(just _committed-release-pypi-policy HEAD)"
    if [[ "$current_release_pypi" != "true" ]]; then
        echo "PyPI publication is disabled by RELEASE_PYPI in the current committed justfile." >&2
        exit 1
    fi
    tag_release_pypi="$(just _committed-release-pypi-policy "$tag")"
    if [[ "$tag_release_pypi" != "true" ]]; then
        echo "PyPI publication is disabled by RELEASE_PYPI in tag ${tag}'s committed justfile." >&2
        exit 1
    fi
    just _check-gh

    if ! is_draft="$(gh release view "$tag" --json isDraft --jq .isDraft)"; then
        echo "GitHub Release ${tag} does not exist." >&2
        exit 1
    fi
    if [[ "$is_draft" == "true" ]]; then
        echo "GitHub Release ${tag} is still a draft and cannot be published." >&2
        exit 1
    fi
    wheel_count="$(gh release view "$tag" --json assets --jq '[.assets[].name | select(endswith(".whl"))] | length')"
    sdist_count="$(gh release view "$tag" --json assets --jq '[.assets[].name | select(endswith(".tar.gz"))] | length')"
    if [[ "$wheel_count" != 1 || "$sdist_count" != 1 ]]; then
        echo "GitHub Release ${tag} must contain exactly one wheel and one source archive." >&2
        exit 1
    fi

    gh workflow run release.yml --raw-field "release_tag=${tag}"
    echo "Requested PyPI publication for ${tag}. Follow the workflow URL above."

# Run GitHub Actions triggered by push locally using act
gitactions:
    act push \
      --secret-file .env.secret \
      -P ubuntu-latest=catthehacker/ubuntu:act-latest \
      --container-options "-v $HOME/.act-uv-cache:/root/.cache/uv" \
      --action-offline-mode



