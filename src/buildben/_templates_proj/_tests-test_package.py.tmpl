"""Generated consumer checks for installation declarations and commands."""

from __future__ import annotations

import json
import os
import shutil
import subprocess
from pathlib import Path

import pytest

from apprc.definition.installation import EditableCheckout, RuntimeSlot
from apprc.distribution.metadata import read_project_metadata
from <my_project>.config.app import APP_RC
from <my_project>.installation import INSTALLATION_HOOKS
from <my_project>_distr.make_artifacts import distribution_spec

ROOT = Path(__file__).resolve().parents[1]


def _environment(tmp_path: Path) -> dict[str, str]:
    environment = os.environ.copy()
    for key in (
        "VIRTUAL_ENV",
        "PYTHONHOME",
        "UV_ACTIVE",
        "UV_PROJECT_ENVIRONMENT",
    ):
        environment.pop(key, None)
    environment.pop("PYTHONPATH", None)
    environment["UV_PROJECT_ENVIRONMENT"] = str(ROOT / ".venv")
    for key in tuple(environment):
        if key.startswith("<my_project>".upper() + "_"):
            environment.pop(key)
    for key in (
        "HOME",
        "USERPROFILE",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "XDG_CACHE_HOME",
    ):
        environment[key] = str(tmp_path / key.casefold())
    return environment


def test_native_declaration_uses_installed_hooks() -> None:
    """Keep command identity and typed hooks aligned across authoring/runtime."""
    metadata = read_project_metadata(ROOT)
    spec = distribution_spec(ROOT, metadata)
    assert metadata.command_name == metadata.identity.commands[0]
    assert spec.hooks == INSTALLATION_HOOKS
    assert (
        spec.metadata.identity.apprc_reference
        == "<my_project>.config.app:APP_RC"
    )


def test_app_paths_and_editable_install_help_are_available_before_setup(
    tmp_path: Path,
) -> None:
    """Expose read-only path inspection and the editable install option."""
    environment = _environment(tmp_path)
    script_directory = "Scripts" if os.name == "nt" else "bin"
    command_name = "<my_project>.exe" if os.name == "nt" else "<my_project>"
    command = ROOT / ".venv" / script_directory / command_name
    paths = subprocess.run(
        [str(command), "app", "paths", "--json"],
        env=environment,
        capture_output=True,
        check=False,
        text=True,
    )
    assert paths.returncode == 0, paths.stdout + paths.stderr
    assert json.loads(paths.stdout)["paths"]["config"] is not None
    assert not any(path.exists() for path in tmp_path.iterdir())

    install = subprocess.run(
        [str(command), "app", "install", "--help"],
        env=environment,
        capture_output=True,
        check=False,
        text=True,
    )
    assert install.returncode == 0, install.stdout + install.stderr
    assert "--editable" in install.stdout
    assert "-e" in install.stdout


def test_editable_install_registers_the_existing_checkout_and_environment(
    tmp_path: Path,
) -> None:
    """Register the existing locked checkout without taking ownership of it."""
    uv = shutil.which("uv")
    assert uv is not None, "Editable installation requires uv."
    environment = _environment(tmp_path)
    environment.pop("UV_NO_SYNC", None)
    command_directory = tmp_path / "commands"
    command_directory.mkdir()
    environment["PATH"] = os.pathsep.join(
        (str(command_directory), environment.get("PATH", ""))
    )
    install = subprocess.run(
        [
            uv,
            "run",
            "--locked",
            "<my_project>",
            "app",
            "install",
            "-e",
            "--yes",
            "--command-directory",
            str(command_directory),
        ],
        cwd=ROOT,
        env=environment,
        capture_output=True,
        check=False,
        text=True,
    )
    assert install.returncode == 0, install.stdout + install.stderr
    record = APP_RC.installation(environment=environment).inspect().record
    assert record is not None
    runtime = record.active_runtime
    assert isinstance(runtime, EditableCheckout)
    assert runtime.project == ROOT.resolve()
    assert runtime.environment == (ROOT / ".venv").resolve()
    assert ROOT.is_dir()


@pytest.mark.skipif(
    os.environ.get("APPRC_TEST_PYAPP") != "1",
    reason="native PyApp installation is opt-in",
)
def test_managed_setup_registers_native_runtime_and_real_resources(
    tmp_path: Path,
) -> None:
    """Install the authored setup, forward through its RuntimeSlot, and initialize."""
    metadata = read_project_metadata(ROOT)
    setup = ROOT / "dist" / f"{metadata.identity.app_id}-setup-linux-x86_64"
    assert setup.is_file() and not setup.is_symlink()
    environment = _environment(tmp_path)
    command_directory = tmp_path / "commands"
    command_directory.mkdir()
    environment["PATH"] = os.pathsep.join(
        (str(command_directory), environment.get("PATH", ""))
    )
    installed = subprocess.run(
        [
            str(setup),
            "--yes",
            "--skip-setup",
            "--command-directory",
            str(command_directory),
        ],
        cwd=tmp_path,
        env=environment,
        capture_output=True,
        check=False,
        text=True,
    )
    assert installed.returncode == 0, installed.stdout + installed.stderr

    record = APP_RC.installation(environment=environment).inspect().record
    assert record is not None
    assert isinstance(record.active_runtime, RuntimeSlot)
    command = command_directory / metadata.command_name
    assert command.is_file()
    paths_result = subprocess.run(
        [str(command), "app", "paths", "--json"],
        cwd=tmp_path,
        env=environment,
        capture_output=True,
        check=False,
        text=True,
    )
    assert paths_result.returncode == 0, (
        paths_result.stdout + paths_result.stderr
    )
    config = Path(json.loads(paths_result.stdout)["paths"]["config"])
    setup_result = subprocess.run(
        [str(command), "config", "setup", "--yes"],
        cwd=tmp_path,
        env=environment,
        capture_output=True,
        check=False,
        text=True,
    )
    assert setup_result.returncode == 0, (
        setup_result.stdout + setup_result.stderr
    )
    set_result = subprocess.run(
        [
            str(command),
            "config",
            "set",
            "app.message",
            "managed fixture",
            "--scope",
            "user",
        ],
        cwd=tmp_path,
        env=environment,
        capture_output=True,
        check=False,
        text=True,
    )
    assert set_result.returncode == 0, set_result.stdout + set_result.stderr
    show_result = subprocess.run(
        [str(command), "config", "show", "--json"],
        cwd=tmp_path,
        env=environment,
        capture_output=True,
        check=False,
        text=True,
    )
    assert show_result.returncode == 0, show_result.stdout + show_result.stderr
    assert (
        json.loads(show_result.stdout)["config"]["message"] == "managed fixture"
    )
    assert config.is_dir() and any(config.iterdir())
