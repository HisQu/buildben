"""Stage only committed native setups and their exact SHA256SUMS."""

from __future__ import annotations

import argparse
import shutil
from pathlib import Path

from apprc.distribution import read_project_metadata
from apprc.distribution.native import NativeTarget

from <my_project>_distr.make_artifacts import TARGETS, build_artifacts
from <my_project>_dev.packaging import release_assets
from <my_project>_dev.packaging.release_manifest import validate_directory

REPOSITORY = "<github_user>/<my_project>"


def stage_release(
    tag: str,
    commit: str,
    *,
    root: Path,
    repository: str = REPOSITORY,
    extras: tuple[str, ...] = (),
    targets: tuple[NativeTarget, ...] = TARGETS,
) -> tuple[str, ...]:
    """Build a committed snapshot and stage only its two native setup files.

    :param tag: Version tag already selected by the release workflow.
    :param commit: Full immutable source revision to snapshot.
    :param root: Application repository root.
    :param repository: Explicit GitHub owner/repository.
    :param extras: Runtime extras selected for the native product.
    :param targets: Native SDK compilation targets.
    :return: Two setup names and their SHA256SUMS filename.
    """
    root = root.resolve()
    if root != Path.cwd().resolve():
        raise ValueError(
            "Run release staging from the application repository root."
        )
    metadata = read_project_metadata(root)
    release_assets.Identity(
        release_assets._repository(repository),
        release_assets._tag(tag),
        release_assets._sha(commit),
    )
    if tag != f"v{metadata.version}":
        raise ValueError("Release tag does not match project metadata.")
    built = build_artifacts(
        root, revision=commit, extras=extras, targets=targets
    )
    names = tuple(
        path.name
        for path in built
        if path.name.endswith(
            ("setup-linux-x86_64", "setup-windows-x86_64.exe")
        )
    )
    destination = root / "release" / "assets"
    if destination.is_symlink():
        raise ValueError("Release staging directory cannot be linked.")
    destination.mkdir(parents=True, exist_ok=True)
    existing = {path.name for path in destination.iterdir()}
    if existing - set(names) - {"SHA256SUMS"}:
        raise ValueError("Release staging directory contains unexpected files.")
    for name in names:
        target = destination / name
        source = root / "dist" / name
        if target.is_symlink() or (target.exists() and not target.is_file()):
            raise ValueError(
                f"Release staging output is not a regular file: {name}."
            )
        shutil.copyfile(source, target)
        if name.endswith("setup-linux-x86_64"):
            target.chmod(0o755)
    release_assets.stage(
        destination,
        list(names),
        repository=repository,
        tag=tag,
        commit=commit,
    )
    return validate_directory(
        destination, app_id=metadata.identity.app_id, exact=True
    )


def main() -> None:
    """Parse release identity and stage SDK-produced setup outputs."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("tag")
    parser.add_argument("commit")
    parser.add_argument("--repository", default=REPOSITORY)
    parser.add_argument("--extra", action="append", default=[])
    arguments = parser.parse_args()
    print(
        "\n".join(
            stage_release(
                arguments.tag,
                arguments.commit,
                root=Path.cwd(),
                repository=arguments.repository,
                extras=tuple(arguments.extra),
            )
        )
    )


if __name__ == "__main__":
    main()
