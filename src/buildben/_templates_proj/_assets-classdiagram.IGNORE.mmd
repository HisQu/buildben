---
config:
  title: "{my_project} class diagram"
  theme: base
  themeVariables:
    fontSize: 20px
    primaryTextColor: "#000000"
    primaryColor: "#cccccc77"
    primaryBorderColor: "#666666"
    lineColor: "#00A2FF"
    secondaryColor: "#00A2FF19"
    tertiaryTextColor: "#000000"
    tertiaryColor: "#44444419"
    tertiaryBorderColor: "#00000000"
---

classDiagram
    direction TB

    class {MyProject}Application {
        +run() None
        +load_config() Config
    }

    class Config {
        +name: str
        +debug: bool
    }

    class Service {
        +execute() Result
    }

    class ServiceContract {
        +execute() Result
    }

    class Result {
        +status: str
        +message: str
    }

    class ExternalSystem {
        +request() Response
    }

    %% Connections
    %% Inheritance: Parent <|-- Child means "is-a". The arrow points to the parent.
    %% Composition: Whole *-- Part means "part-of". The filled diamond marks the whole.
    %% Aggregation: Whole o-- Part means "has-a". The open diamond marks the whole.
    %% Association: A --> B points from A to its related target B.
    %% Dependency: Dependent ..> Supplier means "depends-on". The arrow points to the supplier.

    class ApplicationBase
    ApplicationBase <|-- {MyProject}Application : extends
    ServiceContract <|.. Service : implements
    {MyProject}Application *-- Config : owns
    {MyProject}Application o-- Service : has
    Service --> Result : returns
    Service ..> ExternalSystem : calls
