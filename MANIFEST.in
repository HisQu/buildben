include uv.lock
include pylock.toml
include app-install.sh app-install.cmd
include app-launch.sh app-launch.cmd
include app-uninstall.sh app-uninstall.cmd

recursive-include src/buildben *
recursive-include src/buildben_dev *
recursive-include src/buildben_distr *

prune INPUT
prune OUTPUT
prune .venv
prune venv
prune build
prune dist
prune logs
prune .agent-sessions
prune AGENT_SESSIONS
prune .git
prune .pytest_cache
prune .ruff_cache
prune __pycache__
recursive-exclude * *.py[cod]
recursive-exclude * *.log
recursive-exclude tests *
recursive-exclude assets *
