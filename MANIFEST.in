include uv.lock
include pylock.toml

recursive-include src/buildben *
recursive-include src/buildben_dev *
recursive-include src/buildben_distr *

prune INPUT
prune OUTPUT
prune .venv
prune venv
prune build
prune dist
prune logs
prune .cache
prune node_modules
prune .agent-sessions
prune AGENT_SESSIONS
prune .git
prune .pytest_cache
prune .ruff_cache
prune __pycache__
recursive-exclude * *.py[cod]
recursive-exclude * *.log
recursive-exclude tests *
recursive-exclude assets *
